# Velora environment variable NAMES and safe development placeholders only.
# Copy this file to .env (untracked). NEVER put real credentials here or commit .env.
# Server variables are read ONLY by the Node process. The browser never receives them.

# --- Server (secret; never expose to the client) ---
NODE_ENV=development
PORT=4000
# MongoDB connection for the application database (server-only, control #16).
# Must be a REPLICA SET (or mongos) from Part 2 on: patient/consent/caregiver and
# episode writes run inside transactions. The local dev replica set is started by
# `npm run mongo:test-rs -w server` and serves both this and the test URI.
MONGODB_URI=mongodb://127.0.0.1:27019/velora?replicaSet=rs0
# Separate database used by integration tests. Must be a REPLICA SET (or mongos):
# the Part 2+ invariants rely on transactions. Start one with:
#   npm run mongo:test-rs -w server
MONGODB_TEST_URI=mongodb://127.0.0.1:27019/velora_test?replicaSet=rs0
# Exact CORS allowlist origin for the React dev server (no wildcard, control #10)
CLIENT_ORIGIN=http://localhost:5173
# Pepper for hashing opaque session tokens at rest (run `npm run gen:env` to generate)
SESSION_PEPPER=replace-with-long-random-string
# 32-byte base64 key that encrypts TOTP secrets at rest (run `npm run gen:env` to generate)
MFA_ENCRYPTION_KEY=replace-with-32-byte-base64-key
# Absolute session lifetime in hours
SESSION_TTL_HOURS=12
# info | warn | error (verbose diagnostics stay off in production, control #12)
LOG_LEVEL=info
# Set to true only behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false

# --- Test replica set (`npm run mongo:test-rs -w server`; all optional) ---
# Explicit path to the mongod binary when it is not on PATH
# MONGOD_PATH=C:/Program Files/MongoDB/Server/8.0/bin/mongod.exe
# Port, replica-set name and data directory for the disposable test instance
TEST_MONGO_PORT=27019
TEST_MONGO_REPLSET=rs0
# TEST_MONGO_DBPATH=.mongodb-test/rs0

# --- Part 4: private encrypted document storage ---
# Absolute path OUTSIDE the repository and any web root. Validated at startup:
# a relative path, or one inside the repo, fails closed. Documents are stored
# encrypted here, addressed by opaque UUID keys - never by filename.
DOCUMENT_STORAGE_ROOT=/absolute/path/outside/the/repo/velora-documents
# Separate 32-byte base64 key that encrypts document objects at rest. It is
# DISTINCT from MFA_ENCRYPTION_KEY; both are required (validated at startup).
DOCUMENT_ENCRYPTION_KEY=replace-with-32-byte-base64-key
# Hard upload ceiling (10 MiB) enforced before the body is buffered.
DOCUMENT_MAX_BYTES=10485760
# Bounded parser worker: wall-clock time, memory cap, concurrency and queue.
DOCUMENT_PARSER_TIMEOUT_MS=3000
DOCUMENT_PARSER_MEMORY_MB=128
DOCUMENT_PARSER_CONCURRENCY=2
DOCUMENT_PARSER_QUEUE_MAX=8

# --- Part 6: AI-assisted draft extraction (NO provider is selected by default) ---
# The shipped default is `none`: the whole product works with AI disabled, the
# manual Part 5 workflow is unaffected, and no key is required. Only `none` and
# the LOCAL deterministic `fake` provider exist until an owner selects a vendor
# (control #22); a real provider needs a disclosure first and a server-side key.
EXTRACTION_PROVIDER=none
# Server-only key, ONLY for a provider that needs one. NEVER prefixed with VITE_
# and never sent to the browser (controls #1, #16). Leave unset for none/fake.
# EXTRACTION_API_KEY=replace-with-provider-key
# Optional model/service name for a provider that takes one. Server-only.
# EXTRACTION_MODEL=replace-with-model-name
# Bounded job I/O and limits (control #8): max document text to the model, max
# response bytes, wall-clock timeout, bounded retries, per-hour job and per-day
# run budgets.
EXTRACTION_MAX_INPUT_CHARS=60000
EXTRACTION_MAX_OUTPUT_BYTES=262144
EXTRACTION_TIMEOUT_MS=10000
EXTRACTION_MAX_RETRIES=2
EXTRACTION_JOBS_PER_HOUR=30
EXTRACTION_RUNS_PER_DAY=200

# --- Client (public build-time values only) ---
VITE_API_BASE_URL=/api
