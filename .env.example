# Velora environment variable NAMES and safe development placeholders only.
# Copy this file to .env (untracked). NEVER put real credentials here or commit .env.
# Server variables are read ONLY by the Node process. The browser never receives them.

# --- Server (secret; never expose to the client) ---
NODE_ENV=development
PORT=4000
# MongoDB connection for the application database (server-only, control #16).
# Must be a REPLICA SET (or mongos) from Part 2 on: patient/consent/caregiver and
# episode writes run inside transactions. The local dev replica set is started by
# `npm run mongo:test-rs -w server` and serves both this and the test URI.
MONGODB_URI=mongodb://127.0.0.1:27019/velora?replicaSet=rs0
# Separate database used by integration tests. Must be a REPLICA SET (or mongos):
# the Part 2+ invariants rely on transactions. Start one with:
#   npm run mongo:test-rs -w server
MONGODB_TEST_URI=mongodb://127.0.0.1:27019/velora_test?replicaSet=rs0
# Exact CORS allowlist origin for the React dev server (no wildcard, control #10)
CLIENT_ORIGIN=http://localhost:5173
# Pepper for hashing opaque session tokens at rest (run `npm run gen:env` to generate)
SESSION_PEPPER=replace-with-long-random-string
# 32-byte base64 key that encrypts TOTP secrets at rest (run `npm run gen:env` to generate)
MFA_ENCRYPTION_KEY=replace-with-32-byte-base64-key
# Absolute session lifetime in hours
SESSION_TTL_HOURS=12
# info | warn | error (verbose diagnostics stay off in production, control #12)
LOG_LEVEL=info
# Set to true only behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false

# --- Test replica set (`npm run mongo:test-rs -w server`; all optional) ---
# Explicit path to the mongod binary when it is not on PATH
# MONGOD_PATH=C:/Program Files/MongoDB/Server/8.0/bin/mongod.exe
# Port, replica-set name and data directory for the disposable test instance
TEST_MONGO_PORT=27019
TEST_MONGO_REPLSET=rs0
# TEST_MONGO_DBPATH=.mongodb-test/rs0

# --- Client (public build-time values only) ---
VITE_API_BASE_URL=/api
