{
  "name": "velora",
  "version": "0.1.0",
  "private": true,
  "description": "Velora - AI-assisted post-discharge recovery coordination (clinician-approved plans only)",
  "license": "UNLICENSED",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "test": "npm run test -w server && npm run test -w client",
